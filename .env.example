# Copy this file to .env and fill in the values. Never commit .env.

# Google PageSpeed Insights API key (required)
# https://developers.google.com/speed/docs/insights/v5/get-started#APIKey
PSI_API_KEY=

# HTTP server
PORT=3000
HOST=0.0.0.0

# How often every URL is checked (minutes)
FETCH_INTERVAL_MINUTES=15

# Parallel PSI requests per cycle
FETCH_CONCURRENCY=4

# Per-request timeout (seconds)
REQUEST_TIMEOUT_SECONDS=120

# Hits older than this are deleted
RETENTION_DAYS=30

# Full Lighthouse reports (~330 KB each, gzipped) are kept this long; 0 = don't keep them.
# After that the hit keeps its scores and a summary report.
REPORT_RETENTION_DAYS=7

# Availability & response time from Indian cities (Globalping probes).
# Comma-separated city names; leave empty to turn location checks off.
UPTIME_LOCATIONS=Mumbai,Delhi,Bengaluru,Hyderabad,Chennai,Pune
UPTIME_INTERVAL_MINUTES=15
# Optional free token from https://dash.globalping.io for a higher hourly limit (anonymous: 250 tests/hour)
GLOBALPING_TOKEN=

# SQLite database file
DB_PATH=./data/psi.db
