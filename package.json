{
  "name": "pagespeed-insights-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Polls Google PageSpeed Insights for configured project URLs and shows the results on a public dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js"
  },
  "dependencies": {
    "@fontsource/rubik": "5.2.5",
    "chart.js": "4.4.7"
  }
}
